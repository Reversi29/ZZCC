# ============================================================
# Deploy (one-shot schema)
# ============================================================
@v1.post("/deploy")
async def deploy_schema(
    payload: DeployRequest | None = Body(default=None),
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    if payload is None:
        defaults = Path(__file__).with_name("deploy_defaults.json")
        if not defaults.exists():
            raise HTTPException(status_code=500, detail="deploy_defaults.json not found")
        payload = DeployRequest.model_validate_json(defaults.read_text())

    _check_id(payload.space, "空间名")
    for tag in payload.tags:
        _check_id(tag.name, "标签名")
    for edge in payload.edges:
        _check_id(edge.name, "边类型名")

    steps: List[str] = []
    try:
        get_client().create_space(
            sess, name=payload.space,
            vid_type=payload.vid_type,
            partition_num=payload.partition_num,
            replica_factor=payload.replica_factor,
        )
        steps.append(f"space:{payload.space}")
        _wait_space(sess, payload.space)
        steps.append(f"space-ready:{payload.space}")
        for tag in payload.tags:
            cols = [(p.name, p.type) for p in tag.properties]
            get_client().ensure_tag(sess, space=payload.space, tag=tag.name, columns=cols)
            steps.append(f"tag:{tag.name}")
        for edge in payload.edges:
            cols = [(p.name, p.type) for p in edge.properties]
            get_client().ensure_edge(sess, space=payload.space, edge=edge.name, columns=cols)
            steps.append(f"edge:{edge.name}")
    except NebulaError as e:
        raise HTTPException(status_code=400, detail=str(e))

    _log.info("deployed", space=payload.space, steps=steps)
    return {"ok": True, "data": {"space": payload.space, "steps": steps}}


# ============================================================
# CSV import
# ============================================================
def _coerce(raw: str | None) -> Any:
    if raw is None:
        return None
    s = raw.strip()
    if not s:
        return None
    low = s.lower()
    if low in ("true", "false"):
        return low == "true"
    try:
        if s.startswith("0") and len(s) > 1:
            raise ValueError
        return int(s)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        return s


@v1.post("/import/csv/vertices")
async def import_vertices_csv(
    space: str,
    tag: str,
    file: UploadFile = File(...),
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(space, "空间名")
    _check_id(tag, "标签名")
    reader = csv.DictReader(io.TextIOWrapper(file.file, encoding="utf-8"))
    if not reader.fieldnames or "vid" not in reader.fieldnames:
        raise HTTPException(status_code=400, detail="CSV must have 'vid' column")
    count, errors = 0, []
    for i, row in enumerate(reader, 1):
        vid = (row.get("vid") or "").strip()
        if not vid:
            continue
        props = {k: _coerce(v) for k, v in row.items() if k != "vid" and v}
        try:
            _check_props(props)
            get_client().insert_vertex(sess, space=space, vid=vid, tag=tag, props=props)
            count += 1
        except NebulaError as e:
            errors.append(f"row {i} ({vid}): {e}")
    return {"ok": True, "data": {"imported": count, "errors": errors[:50]}}


@v1.post("/import/csv/edges")
async def import_edges_csv(
    space: str,
    edge: str,
    file: UploadFile = File(...),
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(space, "空间名")
    _check_id(edge, "边类型名")
    reader = csv.DictReader(io.TextIOWrapper(file.file, encoding="utf-8"))
    if not reader.fieldnames or "src" not in reader.fieldnames or "dst" not in reader.fieldnames:
        raise HTTPException(status_code=400, detail="CSV must have 'src' and 'dst' columns")
    count, errors = 0, []
    for i, row in enumerate(reader, 1):
        src = (row.get("src") or "").strip()
        dst = (row.get("dst") or "").strip()
        if not src or not dst:
            continue
        props = {k: _coerce(v) for k, v in row.items() if k not in ("src", "dst") and v}
        try:
            _check_props(props)
            get_client().insert_edge(sess, space=space, src=src, dst=dst, edge=edge, props=props)
            count += 1
        except NebulaError as e:
            errors.append(f"row {i} ({src}->{dst}): {e}")
    return {"ok": True, "data": {"imported": count, "errors": errors[:50]}}


# ============================================================
# Mount routers
# ============================================================
app.include_router(v1)


# ============================================================
# Resolve forward-ref models
# ============================================================
TagCreate.model_rebuild()
DeployRequest.model_rebuild()
