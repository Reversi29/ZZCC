@v1.get("/tags", response_model=TagListResp)
async def list_tags(
    space: str,
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(space, "空间名")
    resp = _run(sess, f"USE `{space}`; SHOW TAGS;")
    tags = []
    for row in resp.rows():
        vals = row.values
        if vals:
            try:
                tags.append({"Name": vals[0].as_string()})
            except AttributeError:
                tags.append({"Name": str(vals[0])})
    return {"ok": True, "data": {"tags": tags}}


@v1.post("/tags", status_code=201)
async def create_tag(
    payload: TagCreate,
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(payload.space, "空间名")
    _check_id(payload.tag, "标签名")
    for p in payload.properties:
        _check_id(p.name, "属性名")
    cols = [(p.name, p.type) for p in payload.properties]
    try:
        get_client().ensure_tag(sess, space=payload.space, tag=payload.tag, columns=cols)
    except NebulaError as e:
        raise HTTPException(status_code=400, detail=str(e))
    return {"ok": True, "data": {"tag": payload.tag}}


@v1.delete("/tags")
async def drop_tag(
    payload: TagDrop,
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(payload.space, "空间名")
    _check_id(payload.tag, "标签名")
    try:
        get_client().drop_tag(sess, space=payload.space, tag=payload.tag)
    except NebulaError as e:
        raise HTTPException(status_code=400, detail=str(e))
    return {"ok": True, "data": {"tag": payload.tag}}


