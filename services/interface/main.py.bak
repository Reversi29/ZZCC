"""
NebulaGraph Interface — FastAPI service.

Architectural principles:
- Config from env / .env via python-dotenv
- Lifespan: init pool on startup, close on shutdown
- NebulaError → HTTP 400, internal errors → HTTP 500
- Consistent response: {ok: bool, data: ...}
- API version prefix /api/v1
- Optional API-key auth (X-API-Key header, enabled via API_KEY env var)
"""
from __future__ import annotations

import csv
import io
import logging
import os
import re
import time
from contextlib import asynccontextmanager
from pathlib import Path
from typing import Annotated, Any, Dict, List, Optional

import structlog
from dotenv import load_dotenv
from fastapi import (
    APIRouter,
    Body,
    Depends,
    FastAPI,
    File,
    Header,
    HTTPException,
    Query,
    UploadFile,
    status,
)
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field, field_validator
from pypdf import PdfReader
from docx import Document

from modules.nebula_client import NebulaClient, NebulaError

# ============================================================
# Config
# ============================================================
load_dotenv()

NEBULA_HOST = os.getenv("NEBULA_HOST", "124.223.47.167")
NEBULA_PORT = int(os.getenv("NEBULA_PORT", "9669"))
NEBULA_USER = os.getenv("NEBULA_USER", "root")
NEBULA_PASSWORD = os.getenv("NEBULA_PASSWORD", "nebula")
API_KEY = os.getenv("API_KEY", "")   # empty = auth disabled
API_VERSION = os.getenv("API_VERSION", "1")

_log = structlog.get_logger()

# ============================================================
# Client singleton
# ============================================================
_client: NebulaClient | None = None


def get_client() -> NebulaClient:
    if _client is None:
        raise RuntimeError("Nebula client not initialized")
    return _client


# ============================================================
# Lifespan
# ============================================================
@asynccontextmanager
async def lifespan(app: FastAPI):
    global _client
    _log.info("nebula_connect", host=NEBULA_HOST, port=NEBULA_PORT)
    _client = NebulaClient(
        host=NEBULA_HOST,
        port=NEBULA_PORT,
        user=NEBULA_USER,
        password=NEBULA_PASSWORD,
    )
    if not _client.init_pool():
        _log.error("nebula_pool_init_failed")
        raise RuntimeError(f"NebulaGraph connection failed: {NEBULA_HOST}:{NEBULA_PORT}")
    _log.info("nebula_pool_ready")
    yield
    _client.close()
    _log.info("nebula_pool_closed")


# ============================================================
# App
# ============================================================
app = FastAPI(
    title="NebulaGraph Interface",
    version=API_VERSION,
    lifespan=lifespan,
)
v1 = APIRouter(prefix="/api/v1")


# ============================================================
# Auth
# ============================================================
async def require_api_key(
    x_api_key: Annotated[str | None, Header(alias="X-API-Key")] = None,
) -> str:
    if not API_KEY:
        return ""
    if x_api_key != API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing X-API-Key")
    return x_api_key


async def get_session(
    nebula_host: Annotated[str | None, Header(alias="X-Nebula-Host")] = None,
    nebula_port: Annotated[int | None, Header(alias="X-Nebula-Port")] = None,
    nebula_user: Annotated[str | None, Header(alias="X-Nebula-User")] = None,
    nebula_password: Annotated[str | None, Header(alias="X-Nebula-Password")] = None,
):
    client = get_client()
    return client.session_with(
        host=nebula_host,
        port=nebula_port,
        user=nebula_user,
        password=nebula_password,
    )


# ============================================================
# Shared helpers
# ============================================================
IDENTIFIER_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def _check_id(name: str, kind: str) -> None:
    if not IDENTIFIER_RE.match(name):
        raise HTTPException(
            status_code=400,
            detail=(
                f"{kind} '{name}' 非法。"
                "标识符必须匹配 ^[A-Za-z_][A-Za-z0-9_]*$，"
                "以字母或下划线开头，仅含字母、数字、下划线。"
            ),
        )


def _check_props(props: Dict[str, Any]) -> None:
    for k in props:
        _check_id(str(k), "属性名")


def _run(sess, stmt: str):
    """Execute nGQL; NebulaError → 400, internal → 500."""
    try:
        return get_client()._run(sess, stmt)
    except NebulaError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    except Exception as exc:
        _log.error("nebula_internal_error", stmt=stmt[:80], error=str(exc))
        raise HTTPException(status_code=500, detail=f"Internal error: {exc}") from exc


def _rows_to_dicts(resp) -> List[Dict[str, Any]]:
    if not resp.rows():
        return []
    keys = list(resp.keys())
    out = []
    for row in resp.rows():
        obj = {}
        for idx, col in enumerate(keys):
            v = row.values[idx]
            try:
                if v.is_string():
                    obj[col] = v.as_string()
                elif v.is_int():
                    obj[col] = v.as_int()
                elif v.is_double():
                    obj[col] = v.as_double()
                elif v.is_bool():
                    obj[col] = v.as_bool()
                else:
                    obj[col] = str(v)
            except AttributeError:
                obj[col] = str(v)
        out.append(obj)
    return out


def _wait_space(sess, space: str, timeout: int = 60) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            get_client()._run(sess, f"USE `{space}`; YIELD 1;")
            return
        except NebulaError:
            time.sleep(1)
    raise HTTPException(status_code=503, detail=f"Space '{space}' did not become ready within {timeout}s")


# ============================================================
# Pydantic models
# ============================================================
class SpaceCreate(BaseModel):
    name: str
    partition_num: int = Field(3, ge=1)
    replica_factor: int = Field(1, ge=1)
    vid_type: str = Field("FIXED_STRING(64)")

    @field_validator("name")
    @classmethod
    def name_ok(cls, v: str) -> str:
        if not IDENTIFIER_RE.match(v):
            raise ValueError("非法标识符")
        return v


class TagCreate(BaseModel):
    space: str
    tag: str
    properties: List["PropertyDef"] = Field(default_factory=list)


class TagDrop(BaseModel):
    space: str
    tag: str


class EdgeTypeCreate(BaseModel):
    space: str
    edge: str
    properties: List["PropertyDef"] = Field(default_factory=list)


class EdgeTypeDrop(BaseModel):
    space: str
    edge: str


class PropertyDef(BaseModel):
    name: str
    type: str


class TagDef(BaseModel):
    name: str
    properties: List[PropertyDef] = Field(default_factory=list)


class EdgeDef(BaseModel):
    name: str
    properties: List[PropertyDef] = Field(default_factory=list)


class DeployRequest(BaseModel):
    space: str
    partition_num: int = Field(3, ge=1)
    replica_factor: int = Field(1, ge=1)
    vid_type: str = Field("FIXED_STRING(64)")
    tags: List[TagDef] = Field(default_factory=list)
    edges: List[EdgeDef] = Field(default_factory=list)


class VertexCreate(BaseModel):
    space: str
    tag: str
    vid: str = Field(..., min_length=1)
    props: Dict[str, Any] = Field(default_factory=dict)


class VertexDelete(BaseModel):
    space: str
    vid: str
    with_edges: bool = True


class EdgeCreate(BaseModel):
    space: str
    edge: str
    src: str = Field(..., min_length=1)
    dst: str = Field(..., min_length=1)
    props: Dict[str, Any] = Field(default_factory=dict)


class EdgeDelete(BaseModel):
    space: str
    edge: str
    src: str
    dst: str


class TagListResp(BaseModel):
    ok: bool
    data: Dict[str, List[Dict[str, Any]]]


class EdgeListResp(BaseModel):
    ok: bool
    data: Dict[str, List[Dict[str, Any]]]


class VertexResp(BaseModel):
    ok: bool
    data: Dict[str, Any]


class EdgeResp(BaseModel):
    ok: bool
    data: Dict[str, Any]


# ============================================================
# Root endpoints
# ============================================================
@app.get("/")
async def root():
    return {"service": "NebulaGraph Interface", "version": API_VERSION, "docs": "/docs"}


@app.get("/health")
async def health():
    try:
        with get_client().session() as sess:
            get_client()._run(sess, "SHOW HOSTS;")
        return {"status": "ok", "nebula": "connected"}
    except Exception as e:
        return JSONResponse(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            content={"status": "degraded", "nebula": str(e)},
        )


# ============================================================
# Space endpoints
# ============================================================
@v1.post("/spaces", status_code=201)
async def create_space(
    payload: SpaceCreate,
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    try:
        get_client().create_space(
            sess,
            name=payload.name,
            vid_type=payload.vid_type,
            partition_num=payload.partition_num,
            replica_factor=payload.replica_factor,
        )
    except NebulaError as e:
        raise HTTPException(status_code=400, detail=str(e))
    _wait_space(sess, payload.name)
    _log.info("space_created", space=payload.name)
    return {"ok": True, "data": {"space": payload.name}}


@v1.get("/spaces")
async def list_spaces(
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    resp = _run(sess, "SHOW SPACES;")
    spaces = []
    for row in resp.rows():
        vals = row.values
        if vals:
            try:
                spaces.append({"Name": vals[0].as_string()})
            except AttributeError:
                spaces.append({"Name": str(vals[0]).strip()})
    return {"ok": True, "data": {"spaces": spaces}}


@v1.delete("/spaces/{name}")
async def drop_space(
    name: str,
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(name, "空间名")
    try:
        get_client().drop_space(sess, name)
    except NebulaError as e:
        raise HTTPException(status_code=400, detail=str(e))
    _log.info("space_dropped", space=name)
    return {"ok": True, "data": {"space": name}}


# ============================================================
# Query
# ============================================================
@v1.get("/query")
async def run_query(
    q: str = Query(..., description="nGQL statement"),
    space: str = Query(..., description="Target space name"),
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(space, "空间名")
    resp = _run(sess, f"USE `{space}`; {q}")
    return {"ok": True, "data": {"rows": _rows_to_dicts(resp), "columns": list(resp.keys()) if resp.rows() else []}}


