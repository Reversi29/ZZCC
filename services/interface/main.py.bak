@v1.get("/vertices/{vid}", response_model=VertexResp)
async def fetch_vertex(
    vid: str,
    space: str = Query(...),
    tag: str | None = None,
    sess=Depends(get_session),
    auth: str | None = Depends(require_api_key),
):
    _check_id(space, "空间名")
    if tag:
        _check_id(tag, "标签名")
    try:
        resp = get_client().fetch_vertex(sess, space=space, vid=vid, tag=tag)
    except NebulaError as e:
        raise HTTPException(status_code=400, detail=str(e))
    return {"ok": True, "data": {"vid": vid, "tag": tag, "rows": _rows_to_dicts(resp)}}


