# Nebula Interface — 本地双端验证
NEBULA_HOST=nebulagraph-stack-graphd1-1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# KnowledgeTable database and Redis
KT_DB_USER=ktuser
KT_DB_PASSWORD=ktpass
KT_DB_NAME=ktdb
KT_DB_HOST=db
KT_DB_PORT=5432
KT_REDIS_HOST=kt-redis
KT_REDIS_PORT=6379

BRAIN_CONFIG_FILE=/app/config_data/brain_config.json

# Streaming (SRS) — 广场视频/直播
STREAMING_API_URL=http://srs-server:1985
STREAMING_HLS_BASE=http://srs-server:8080/hls
STREAMING_RTMP_BASE=rtmp://srs-server:1935/live
STREAMING_UPLOAD_DIR=/app/config_data/feed_media
