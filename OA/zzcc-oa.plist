<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist>
<dict>
    <key>Label</key>
    <string>zzcc.oa.composer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mac/ZZCC/OA/scripts/oa-autostart.sh</string>
    </array>

    <!--
      不直接调 docker compose：
        1. Docker Desktop 引擎就绪晚于 launchd 触发，直调会 daemon not running；
           脚本内含轮询等待（最多 240s）。
        2. 原路径 /opt/homebrew/bin/docker 在本机不存在
           （真实路径 /usr/local/bin/docker）。
      KeepAlive=false + RunAtLoad=true：只在登录时启动一次，
      后续容器存活由 unless-stopped restart policy 保证。
    -->

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/mac/ZZCC/OA/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mac/ZZCC/OA/logs/launchd-stderr.log</string>
</dict>
</plist>